# Copy to .env (gitignored) for local dev: `cp .env.example .env`
# .env holds local-only secrets; never commit it. Prod = real secret manager (Vault swap-in).

# Postgres (operational state)
POSTGRES_USER=tsa
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tsa
POSTGRES_PORT=5432

# Phoenix (LLM tracing) — host ports
PHOENIX_PORT=6006
PHOENIX_OTLP_GRPC_PORT=4317

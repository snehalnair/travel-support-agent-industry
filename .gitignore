# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Virtual environment (uv manages this; never commit it)
.venv/

# Secrets / local env
.env

# Terraform / OpenTofu
# Ignore the plugin cache, state, and crash logs. Keep .terraform.lock.hcl —
# it pins exact provider versions/checksums and is meant to be committed.
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# *.tfvars may hold secrets; commit *.tfvars.example instead.
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
